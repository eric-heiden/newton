[Unit]
Description=Newton research dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/newton
Environment=PYTHONUNBUFFERED=1
Environment=NEWTON_RESEARCH_HOST=0.0.0.0
Environment=NEWTON_RESEARCH_PORT=7070
Environment=NEWTON_RESEARCH_ARTIFACT_PATH=%h/newton/scripts/research_dashboard.json
ExecStart=%h/newton/scripts/research/serve_dashboard.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
